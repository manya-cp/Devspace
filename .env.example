# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_URL: Base URL for backend API requests (defaults to /api if omitted)
VITE_API_URL="/api"

# MONGODB_URI: MongoDB connection string (e.g. mongodb://localhost:27017/devspace or MongoDB Atlas cluster)
MONGODB_URI="mongodb://localhost:27017/devspace"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="devspace-jwt-production-secret-2026"

# PORT: Server listening port (default: 3000)
PORT="3000"
